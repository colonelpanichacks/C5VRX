9135 46783 46527 46527 30015 46207 29503 29242 37366 28469 36206 11432 11172 11038 19099 10900 10895 22218 46726 30213 46400 29952 46080 45824 28928 36352 19684 11081 18962 10914 10625 10682 10687 22527 47039 47039 46783 46719 46463 46143 37567 36088 19124 18796 10729 10659 10397 10458 10389 55310 47308 47302 47040 47040 47040 46720 46080 33984 26240 18240 18240 10176 10304 10304 10304 55360 55423 55423 55679 55679 55679 55935 56447 49788 25781 17779 9964 9961 10082 10077 2009 55699 55695 55689 55942 55936 56192 56512 65024 57792 8960 9280 9536 9472 9792 1728 1600 55936 56000 56063 56319 64317 64575 64895 65407 8511 49913 1012 9265 1450 1446 1441 9884 6681 56275 64274 64265 64519 64960 7744 65408 8512 57856 960 896 1152 1344 1344 1344 56192 6912 64256 64639 64959 7460 7743 7999 63 383 700 1015 882 1133 9256 9571 56287 7194 7188 64591 7431 7683 7936 0 0 320 640 832 960 9216 9216 9216 64512 64570 7231 7487 7487 7743 65535 63 63 383 703 700 1008 881 9259 9255 64547 64543 64857 7444 65168 65159 65475 0 28864 28480 28224 28224 19776 27968 27648 27648 46080 46119 37862 37884 37546 37492 37170 36925 28927 28607 28351 19967 27960 19703 27697 27694 46122 46116 46112 45849 37846 37516 37193 36866 28867 28544 28224 19904 19776 19520 19648 19392 46400 46272 38080 45887 37870 37504 37247 36927 28671 28351 28031 27967 19583 19519 19321 11252 54574 46444 46440 46112 37852 37844 37519 37192 28617 28291 27968 19520 19200 19200 19200 10816 46720 46464 46400 46400 46143 37824 37567 37247 28671 28031 19711 27455 19327 19007 11005 11002 46773 46768 46763 46438 46433 46105 37844 37197 28369 27658 27396 19008 19008 10688 18688 10688 47040 47040 47040 46720 46726 46400 46143 37567 27903 27199 26943 18879 10751 10495 10495 10367 55355 55350 55345 47084 47079 47071 46746 46100

prime_lookup:
    # First retained endpoint. No previous phase exists yet, so stage-1
    # previous-MSB context is zero.
    set 16..23 8..15,
    set 24 7,
    set 25 L,
    read 16

prime_store:
    # Save the first actual Phase5, then issue stage 1 for the next pair.
    set 26..30 L8..L12,
    set 16..23 8..15,
    set 24 7,
    set 25 L12,
    set 31 L,
    read 16

trajectory:
    # O26..O30 still holds previous actual Phase5. L contains stage-1 output
    # for the current pair. Save current actual phase for the next output while
    # addressing stage 2 with previous Phase5 + learned trajectory token.
    set 26..30 L8..L12,
    set 16..20 O26..O30,
    set 21 L6,
    set 22 L7,
    set 23 L13,
    set 24 L14,
    set 25 L15,
    set 31 L

emit:
    # Emit the stage-2 DAC code twice. At the same time preserve current phase
    # and issue stage 1 for the following [middle,current] raw-Q4 pair.
    set 0..5 L0..L5,
    set 6..7 L,
    set 8..13 L0..L5,
    set 14..15 L,
    set 26..30 O26..O30,
    set 16..23 8..15,
    set 24 7,
    set 25 O30,
    set 31 L,
    read 16,
    write 16,
    jmp trajectory
