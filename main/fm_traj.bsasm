# Trajectory v2: two-stage, two-bundle weak-signal WBFM experiment.
#
# Input: packed Q4/I4 @ 40 MS/s (middle,current pair per 50 ns output).
# Output: 20 MS/s unique 6-bit CVBS duplicated [D,D] on the proven 40 MHz DAC.
#
# One physical 1024x16 LUT serves two learned stages:
#
# Stage 1 address (issued by emit):
#   bits 0..7 : current raw Q4/I4 byte
#   bit  8    : middle raw-I sign
#   bit  9    : previous actual Phase5 MSB
# Stage 1 result:
#   L8..L12             : actual current Phase5
#   L6,L7,L13,L14,L15  : learned 5-bit trajectory token
#
# Stage 2 address (issued by trajectory):
#   bits 0..4 : previous actual Phase5
#   bits 5..9 : trajectory token
# Stage 2 result:
#   L0..L5 : final 6-bit CVBS code
#
# Training target is the clean exact-adjacent pair d0+d1 with NO second wrap.
# The learned raw-Q4 token carries amplitude/noise context, so clean signals do
# not have to sacrifice a Phase5 bit to expose the middle sample.
#
# After the two prime bundles, steady state is exactly:
#   trajectory -> emit -> trajectory -> emit ...
cfg prefetch true
cfg eof_on downstream
cfg trailing_bytes 0
cfg lut_width_bits 16
lut 9238 9873 10187 10180 10176 18432 18432 18432 30848 47232 47232 55552 47488 63744 64000 64512 703 9279 9599 9919 9919 10239 10239 10239 47423 47548 55606 55854 55849 56099 64605 65176 348 981 9231 9544 9536 9856 9856 9856 31360 47616 55808 56064 56064 64512 64887 65535 320 703 1023 9279 9599 9599 9599 9919 31423 47935 56123 56117 56369 56746 65125 65503 288 665 980 972 9223 9472 9536 9536 31616 56064 56064 56320 56582 64832 65152 65493 0 320 703 1023 9023 9279 9279 1535 31679 7231 56383 56509 64887 65201 65451 57573 38 353 668 980 973 9221 9216 9216 64512 7168 48256 56576 64896 65152 65408 57536 0 320 703 640 1013 1023 9279 1087 64575 64575 48575 7487 65215 65210 65525 57582 36910 28648 28321 28315 27988 27980 27654 27648 46080 46080 37824 37824 37504 37504 37184 36864 36864 28608 28288 27904 28031 27711 27711 27711 46143 46143 46143 37887 37846 37565 29119 36912 28725 20399 28265 28003 19932 27669 19597 19399 46403 46080 46080 37824 37824 29312 29056 20608 28608 28224 27968 19904 27712 19648 19327 19455 46463 46463 30143 29887 29631 29631 37567 20922 28604 28279 28016 27753 27490 19419 19411 19150 46729 38211 30080 30080 29824 29568 37440 37120 28480 27968 27712 19403 19398 19136 19079 19135 30399 46655 46647 38260 38256 38015 29631 37311 28351 19710 19447 19121 19112 18850 18778 18773 30607 38731 46852 38464 46720 62720 46080 37504 27648 19072 18752 18752 18752 18496 18496 18496 30911 47264 47104 47039 55103 47039 63039 46143 25663 9919 10232 10226 10220 10469 10463 10457 47316 47309 47305 47557 55552 47552 47808 48192 640 9216 9600 9792 9856 10112 10112 10176 55616 47615 47615 47871 47871 56319 48383 48895 8575 831 9279 9595 9523 9836 9828 9887 55961 47828 47820 48073 48065 48320 56640 57216 8448 57984 768 1024 9472 1280 9472 1536 55936 48064 48064 48127 48320 48575 48895 49151 383 575 831 831 1076 1332 9640 1318 56288 56284 56276 7245 48584 7489 7744 65472 0 256 512 768 768 1024 1024 1280 56256 64512 64512 48383 64847 7744 65522 63 63 319 575 831 831 1082 10