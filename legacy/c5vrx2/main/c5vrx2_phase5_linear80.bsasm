prime:
    set 16..23 8..15,
    read 16

address_delta:
    set 0..5 O8..O13,
    set 16..20 L8..L12,
    set 21..25 O26..O30,
    set 26..30 L8..L12,
    LDCTIB

load_sums:
    set 0..5 O0..O5,
    set 8..13 L0..L5,
    set 16..21 O0..O5,
    set 24..29 O0..O5,
    write 8,
    LDCTIA

add_target:
    set 0..5 O0..O5,
    set 8..13 O8..O13,
    set 16..21 O8..O13,
    set 24..29 O8..O13,
    ADDCTIA

add_weights:
    set 0..5 A1..A6,
    set 8..13 O8..O13,
    set 17..22 O0..O5,
    set 25..30 O8..O13,
    ADDCTIA

emit_quarter_mid:
    set 0..5 A2..A7,
    set 8..13 O0..O5,
    set 16..21 O8..O13,
    write 16

emit_threequarter_phase:
    set 0..5 A10..A15,
    set 8..13 O16..O21,
    set 16..23 8..15,
    set 26..30 B10..B14,
    read 16,
    write 8,
    jmp address_delta
