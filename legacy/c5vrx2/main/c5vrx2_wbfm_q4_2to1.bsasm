# Continuous packed Q4/I4 -> full-byte phase LUT -> adjacent WBFM -> real /2.
#
# Each input byte is Q[9:6] in bits 3:0 and I[9:6] in bits 7:4. The 16-bit
# LUT maps the complete byte to:
#
#   L0..L7   = unscaled absolute phase
#   L8..L15  = -unscaled absolute phase
#
# Adding the low byte for the current sample and the saved high byte for the
# previous sample gives phase[n] - phase[n-1], modulo eight bits. Two genuine
# adjacent discriminator results are accumulated. LUT bank 1 then interprets
# that modulo sum as signed, applies the calibrated real-domain gain and /2,
# adds pedestal, and clamps the result to a legal six-bit DAC code.
#
# O8..O15 retains pedestal-phase[n-1] across every normal GDMA ring wrap.

cfg prefetch true
cfg eof_on upstream
# Prefetch holds eight input bytes ahead of execution. C5 PARLIO can derive
# TX EOF from the input DMA stream; flush that pipeline for bounded tests.
# This setting is irrelevant to the eventual infinite cyclic transaction.
cfg trailing_bytes 9
cfg lut_width_bits 16

address1:
    # The C5 16-bit-LUT address is O16..O25 (index bits 0..9). Preserve the
    # previous biased-negative phase in O8..O15 while prefetching sample 2.
    # Reset A here once per pair, avoiding a ninth C5 instruction.
    set 8..15 O8..O15,
    set 16 0,
    set 17 1,
    set 18 2,
    set 19 3,
    set 20 4,
    set 21 5,
    set 22 6,
    set 23 7,
    set 24..25 L,
    read 8,
    LDCTDAL 0

add_current1:
    set 0..7 L8..L15,
    set 8..15 O8..O15,
    set 16..23 L0..L7,
    ADDCTIAL

add_previous1:
    set 0..7 O0..O7,
    set 16..23 O8..O15,
    ADDCTIAL

address2:
    # Sample 1 is now the previous sample. Address sample 2 and prefetch the
    # first byte of the next pair.
    set 8..15 O0..O7,
    set 16 0,
    set 17 1,
    set 18 2,
    set 19 3,
    set 20 4,
    set 21 5,
    set 22 6,
    set 23 7,
    set 24..25 L,
    read 8

add_current2:
    set 0..7 L8..L15,
    set 8..15 O8..O15,
    set 16..23 L0..L7,
    ADDCTIAL

add_previous2:
    set 0..7 O0..O7,
    set 16..23 O8..O15,
    ADDCTIAL

map_cvbs:
    # Select LUT bank 1 (indices 0x100..0x1ff) with the low accumulator byte.
    # Preserve sample 2 as the previous phase for the next pair.
    set 8..15 O0..O7,
    set 16 A0,
    set 17 A1,
    set 18 A2,
    set 19 A3,
    set 20 A4,
    set 21 A5,
    set 22 A6,
    set 23 A7,
    set 24 H,
    set 25 L

emit:
    # The LUT has already applied /2, pedestal and saturation. Retain sample
    # 2's phase state in O8..O15 across the write cycle.
    set 0..5 L0..L5,
    set 6..7 L,
    set 8..15 O8..O15,
    write 8,
    jmp address1
