# SPDX-License-Identifier: GPL-3.0-only

# Seeed Studio XIAO ESP32-C5 output-only PAL proof.
# Native USB is GPIO13/14. Battery sensing is GPIO6/26. Boot is GPIO28.
# GPIO7/GPIO25 are strapping pins. None are used below.
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_C5VRX_BOARD_PROFILE="xiao-esp32c5"
CONFIG_C5VRX_EXPERIMENTAL_CVBS_PARLIO=y
CONFIG_C5VRX_CVBS_OUTPUT_ONLY_TEST=y
CONFIG_C5VRX_CVBS_TEST_COLOR_BURST=y
CONFIG_C5VRX_CVBS_DAC_BITS=6

# PARLIO D0..D5 = XIAO D4,D5,D6,D7,D8,D9.
CONFIG_C5VRX_CVBS_D0_GPIO=23
CONFIG_C5VRX_CVBS_D1_GPIO=24
CONFIG_C5VRX_CVBS_D2_GPIO=11
CONFIG_C5VRX_CVBS_D3_GPIO=12
CONFIG_C5VRX_CVBS_D4_GPIO=8
CONFIG_C5VRX_CVBS_D5_GPIO=9
CONFIG_C5VRX_CVBS_D6_GPIO=-1
CONFIG_C5VRX_CVBS_D7_GPIO=-1
